# PostgreSQL for the full deployment described in the README.
# Example:
# DATABASE_URL=postgresql+psycopg://recruitment:recruitment@localhost:5432/recruitment_ai
#
# Leave DATABASE_URL empty/unset to run the quick demo on SQLite:
#   sqlite:///data/recruitment.db
DATABASE_URL=

DATA_DIR=./data
UPLOAD_DIR=./data/uploads

MAX_UPLOAD_MB=8
MIN_PDF_TEXT_CHARS=50
MAX_ETL_ROWS=50000
MAX_STORED_ROW_ERRORS=500

# Seed fictional demo users/candidates on an empty database.
SEED_DEMO_DATA=true
